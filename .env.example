# Copie para .env e preencha. NUNCA commite o .env (já está no .gitignore).

# Domínio público (aponte o DNS para este servidor) e URL base completa
DOMAIN=transcritor.exemplo.com
BASE_URL=https://transcritor.exemplo.com

# Login Google (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth, tipo "Aplicativo da Web").
# URI de redirecionamento autorizado:  https://transcritor.exemplo.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave da sessão (>= 16 caracteres). Gere com:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Quem pode entrar (ao menos um dos dois; sem lista, ninguém entra). Separe por vírgula.
ALLOWED_EMAILS=voce@gmail.com,colega@gmail.com
ALLOWED_DOMAINS=

# Limites (opcionais)
MAX_UPLOAD_MB=500
MAX_DURATION_MIN=180
JOB_TTL_MIN=60
